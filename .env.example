# Copy to server/.env (or export in your shell). Never commit real values.
# Public address cameras and browsers use (domain with TLS in production)
PUBLIC_URL=https://visionguard.smartwaygroup.com.sa
PORT=3000
RTMP_PORT=1935
FLV_PORT=8000
# Shared camera token (must match cameras.json / --dart-define=BWC_TOKEN)
BWC_TOKEN=change-me
# Secret used to sign live-stream URLs (set a long random value in production)
STREAM_SECRET=change-me-too
# Initial admin password on first run (otherwise a random one is printed)
ADMIN_PASSWORD=
# Override database location (default: server/data)
DATA_DIR=

# Dock Agent shared secret (docking stations upload recordings with it)
DOCK_TOKEN=

# Docker deployment: IP of this host dedicated to VisionGuard (camera RTMP port 1935 binds here)
RTMP_BIND_IP=
