# Copy to server/.env (or export in your shell). Never commit real values.
# Public address cameras and browsers use (domain with TLS in production)
PUBLIC_URL=https://visionguard.smartwaygroup.com.sa
PORT=3000
RTMP_PORT=1935
FLV_PORT=8000
# Shared camera token (must match cameras.json / --dart-define=BWC_TOKEN)
BWC_TOKEN=change-me
# Secret used to sign live-stream URLs (set a long random value in production)
STREAM_SECRET=change-me-too
# Initial admin password on first run (otherwise a random one is printed)
ADMIN_PASSWORD=
# Override database location (default: server/data)
DATA_DIR=

# Dock Agent shared secret (docking stations upload recordings with it)
DOCK_TOKEN=

# Docker deployment: IP of this host dedicated to VisionGuard (camera RTMP port 1935 binds here)
RTMP_BIND_IP=

# Slots shown on the Docking page: 10 = the real dock, 5 on the top row and 5 on the bottom row (default 10)
# DOCK_SLOTS=10

# Delete offloaded recordings this many days after upload (0 or empty = keep forever; use 3 on test/demo servers)
# RECORDINGS_RETENTION_DAYS=3

# Optional: a written AI analysis on the Analytics page (the "Written analysis" button). Only aggregated numbers and camera names are sent,
# never video, file names or user names. Leave empty for the automatic summary. Model defaults to claude-sonnet-5-5.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Help & Support tickets are e-mailed to this address (default shown). Tickets are always stored and answered in the Help page;
# set SMTP_* so each new ticket and customer reply is also mailed to the support desk.
# SUPPORT_EMAIL=sdpt@smart-way.com.sa
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=visionguard@smart-way.com.sa
# PUBLIC_URL=https://visionguard.smartwaygroup.com.sa

# --- Licence (customer installations that run on their own server, see docs/LICENSING.md) ---
# off = Smart Way's own hosted servers (default). A customer's installation must set enforce.
# LICENSE_MODE=off
# LICENSE_TRIAL_DAYS=30        # free trial before a licence is needed (0 = none)
# LICENSE_TRIAL_CAMERAS=10     # camera limit during the trial
# LICENSE_NOTIFY=              # extra e-mail addresses for expiry reminders (needs SMTP_*)

# --- Battery alert and check-out (defaults shown) ---
# BATTERY_LOW=20               # under this % and not charging: low-battery alert
# BATTERY_CRITICAL=10          # under this %: critical
# CHECKOUT_MIN_BATTERY=30      # a camera is ready for an employee from this % (changeable on Docking > Check-out)
# CHECKOUT_HOLD_MIN=10         # minutes a reserved camera is kept for the employee

# --- Behind nginx / a load balancer ---
# TRUST_PROXY=loopback, linklocal, uniquelocal   # so req.ip is the real client (rate limits per person, not per proxy)
# TZ=Asia/Riyadh               # days in reports and charts follow this zone
